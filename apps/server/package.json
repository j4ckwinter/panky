{
  "name": "@panky/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/*/*.test.ts"
  },
  "dependencies": {
    "@panky/shared": "workspace:*",
    "jose": "^6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
