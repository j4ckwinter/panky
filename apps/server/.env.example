# Generate with: openssl rand -hex 32. Never use a VITE_ variable for this token.
AUTH_TOKEN=
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/panky.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_PROVIDER=mock
MODEL_NAME=panky-mock
# Reserved for a future provider; unused by mock mode.
# MODEL_ENDPOINT=http://127.0.0.1:11434
# Bounded task execution: steps 1–32, context characters 8000–128000,
# total duration 100–300000ms. Context includes completed messages, newest first.
MAX_TASK_STEPS=8
HISTORY_MAX_CHARS=16000
MAX_TASK_DURATION_MS=30000
