# Generate with: openssl rand -hex 32. Never use a VITE_ variable for this token.
AUTH_TOKEN=
AUTH_ORIGIN=http://localhost:5173
OWNER_EMAIL=jackwinter.10@gmail.com
# Google OAuth web client ID. No client secret is needed for this flow.
GOOGLE_CLIENT_ID=
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/panky.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_PROVIDER=mock
MODEL_NAME=panky-mock
# For local AI, set MODEL_PROVIDER=ollama and MODEL_NAME=panky-qwen3:4b.
MODEL_ENDPOINT=http://127.0.0.1:11434
MODEL_CONTEXT_LENGTH=4096
# Bounded task execution: steps 1–32, context characters 8000–128000,
# total duration 100–300000ms. Context includes completed messages, newest first.
MAX_TASK_STEPS=8
HISTORY_MAX_CHARS=16000
MAX_TASK_DURATION_MS=30000
# Optional, read-only Notion integration for the owner account only.
# Share only selected pages with the integration. Never use a frontend env var.
NOTION_TOKEN=
# Optional per-user Notion OAuth. Configure all three with Google sign-in.
# Register AUTH_ORIGIN + /api/connections/notion/callback in Notion.
# Generate the encryption key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the key stable and back it up securely with the database; it encrypts user tokens.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_TOKEN_KEY=

# Opt-in owner-only ChatGPT subscription prototype; no API key billing.
CHATGPT_ENABLED=false
CHATGPT_CREDENTIAL_PATH=./data/chatgpt/credentials.json
