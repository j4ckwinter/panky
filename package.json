{
  "name": "panky",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm --filter @panky/server test",
    "test:e2e": "playwright test",
    "evaluate:ollama": "tsx scripts/evaluate-ollama.ts",
    "evaluate:picks": "tsx scripts/evaluate-picks.ts",
    "evaluate:interview": "tsx scripts/interview-evaluation.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "test:production": "pnpm build && playwright test --config playwright.production.config.ts",
    "test:speech": "pnpm build && playwright test --config playwright.speech.config.ts",
    "connect:chatgpt": "pnpm --filter @panky/server connect:chatgpt",
    "audit:picks": "tsx scripts/audit-picks-data.ts",
    "evaluate:picks-model": "tsx scripts/evaluate-picks-model.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "tsx": "4.21.0",
    "@panky/shared": "workspace:*"
  }
}
